#!/bin/sh
# Environment configuration for demo_web release
# This file is sourced before starting the VM

# Node naming for Erlang distribution
# RELEASE_NODE should be set via environment variable (e.g., demo1@hostname)
# If not set, generate a unique name
if [ -z "$RELEASE_NODE" ]; then
    HOSTNAME=$(hostname -s)
    RELEASE_NODE="demo_web_$$@${HOSTNAME}"
    export RELEASE_NODE
fi

# Cookie for cluster authentication
# All nodes in the cluster must share the same cookie
if [ -z "$RELEASE_COOKIE" ]; then
    RELEASE_COOKIE="macula_dev_cookie"
    export RELEASE_COOKIE
fi

# Distribution port range for Erlang
# EPMD (4369) must be accessible between nodes
# Distribution uses ports in INET_DIST_LISTEN_MIN to INET_DIST_LISTEN_MAX
export INET_DIST_LISTEN_MIN="${INET_DIST_LISTEN_MIN:-9100}"
export INET_DIST_LISTEN_MAX="${INET_DIST_LISTEN_MAX:-9105}"

# Erlang VM tuning for containerized environment
export ERL_FLAGS="${ERL_FLAGS:--kernel inet_dist_listen_min ${INET_DIST_LISTEN_MIN} inet_dist_listen_max ${INET_DIST_LISTEN_MAX}}"
